        "family": "foundations",
        "secondary_capabilities": [
          "database-and-storage",
          "http-and-service-edge"
        ],
        "responsibility": "Provide validated tenant identity, explicit tenant, system, and unscoped work, and fail-closed propagation and enforcement seams.",
        "non_goals": [
          "Authenticate callers, decide tenant membership, or authorize access.",
          "Grant PostgreSQL privileges or make row-level security safe when callers bypass the documented predicates, transaction manager, policies, or restricted roles."
        ],
        "public_package_identifier": "tenancy",
        "primary_entry_packages": [
          "github.com/faustbrian/go-tenancy"
        ],
        "package_selection": {
          "github.com/faustbrian/go-tenancy": "Use for validated tenant identity, explicit scope, propagation, opaque provider namespaces, bounded background work, and administration seams.",
          "github.com/faustbrian/go-tenancy/http": "Use at authenticated HTTP boundaries for trust-gated tenant extraction, acceptance, injection, and middleware.",
          "github.com/faustbrian/go-tenancy/jsonrpc": "Use at authenticated JSON-RPC boundaries for bounded, duplicate-safe tenant metadata propagation.",
          "github.com/faustbrian/go-tenancy/postgres": "Use for explicit tenant predicates, PostgreSQL row-level-security plans, and transaction-local tenant enforcement.",
          "github.com/faustbrian/go-tenancy/tenancytest": "Use in tests for deterministic tenant and system scopes and tenant assertions."
        },
